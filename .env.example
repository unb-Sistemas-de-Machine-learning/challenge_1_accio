# Staging Database (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql+asyncpg://fato_user:fato_password@localhost:5432/fato_unb
# SQLite fallback para desenvolvimento e testes locais sem Docker:
# DATABASE_URL=sqlite+aiosqlite:///./fato_unb.db

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Modelos de embedding (opcional; padrão: intfloat/multilingual-e5-large + BM25 com IDF).
# Para o modelo leve anterior: EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Trocar o modelo denso cria outra coleção (sufixo com o nome do modelo): reindexe após a troca.
# SPARSE_MODEL=Qdrant/bm25

# Cache dos modelos do fastembed. O padrão é /tmp/fastembed_cache: em máquinas onde /tmp é tmpfs
# (RAM), modelos grandes (e5-large, jina-v3) enchem a memória e o sistema mata o processo (OOM).
# FASTEMBED_CACHE_PATH=~/.cache/fastembed

# LLM que emite o veredito (scripts/checar.py). Segredos ficam no .env, que é ignorado pelo git.
# LLM_PROVIDER=gemini            # gemini | anthropic | deepseek
# LLM_MODEL=gemini-3.1-flash-lite  # padrão do provedor; o 2.5-flash-lite responde 404 para contas novas
# GEMINI_API_KEY=                # https://aistudio.google.com/apikey (free tier, sem cartão)
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=              # https://platform.deepseek.com/api_keys (pré-pago: recarregue um pouco de saldo)
# Para o DeepSeek: LLM_PROVIDER=deepseek e, se quiser, LLM_MODEL=deepseek-flash

# Observabilidade de LLM (Langfuse): custo, tokens e latência de cada /checar. Sem as duas chaves, fica
# desligada e o bot funciona normalmente. Crie o projeto em https://us.cloud.langfuse.com (ou cloud.langfuse.com).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=producao   # separa produção de testes no painel
# LANGFUSE_TRACING_ENABLED=false          # desliga sem apagar as chaves
# Por padrão o texto das afirmações NÃO é enviado (só um resumo com hash). Para enviar (já com CPF, telefone e
# e-mail mascarados), use true só em desenvolvimento/avaliação, nunca com usuários reais.
# LANGFUSE_CAPTURE_CONTENT=false

# Credenciais do Postgres do docker-compose. A senha é obrigatória: o compose não sobe sem ela.
# Use só letras e números (ela entra na DATABASE_URL). scripts/setup_vm.sh gera uma aleatória.
# Atenção: o Postgres só lê a senha na primeira criação do volume (postgres_data/). Se você já
# subiu o compose antes, use a mesma senha de antes (a antiga era fato_password).
POSTGRES_DB=fato_unb
POSTGRES_USER=fato_user
POSTGRES_PASSWORD=troque-esta-senha

# Intervalo, em minutos, do ciclo de ingestão (crawler + RSS + indexação). Roda dentro do
# próprio bot (JobQueue), então não precisa de um serviço separado. Padrão: 60.
# INGESTAO_INTERVALO_MIN=60

# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=
